# Set these as runtime variables on the HOSTED server, never in the desktop app.
# Choose one provider, keep its account on the free plan.
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional alternative: AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Alternate model on the same service/key. Keep total calls bounded to two.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Explicitly allow one alternate-model call after primary quota exhaustion.
# If unset, 429 is returned without a retry. No billing is enabled here.
GEMINI_QUOTA_FALLBACK=1

# Required email verification/recovery for the central account store.
# Both values stay in hosted Sites secrets; never package them in the EXE.
AUTH_EMAIL_API_KEY=
AUTH_FROM_EMAIL=

# One-time first ADMIN bootstrap; random >=32 characters, remove after use.
AUTH_ADMIN_BOOTSTRAP_TOKEN=
