# Set these as runtime variables on the HOSTED server, never in the desktop app.
# Choose one provider, keep its account on the free plan.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional alternative: AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional email verification/recovery for the central account store.
# Both values stay in hosted Sites secrets; never package them in the EXE.
AUTH_EMAIL_API_KEY=
AUTH_FROM_EMAIL=

# One-time first ADMIN bootstrap; random >=32 characters, remove after use.
AUTH_ADMIN_BOOTSTRAP_TOKEN=
