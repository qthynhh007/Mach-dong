# Set these as runtime variables on the HOSTED server, never in the desktop app.
# Groq is the only provider used by chat, scenario advice and evidence selection.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Required email verification/recovery for the central account store.
# Both values stay in hosted Sites secrets; never package them in the EXE.
AUTH_EMAIL_API_KEY=
AUTH_FROM_EMAIL=

# One-time first ADMIN bootstrap; random >=32 characters, remove after use.
AUTH_ADMIN_BOOTSTRAP_TOKEN=
