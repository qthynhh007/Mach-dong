# AgriData · Mạch Đồng — Local Environment Variables Template
# Copy this file to `.env` in the project root (never commit `.env` to Git).

# 1. App Session & Deterministic secp256k1 Wallet Derivation Key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AGRIDATA_SECRET_KEY=replace-with-a-random-64-char-hex-string

# 2. Gmail SMTP (for sending 6-digit Email OTP confirmation codes)
# Leave SMTP_APP_PASSWORD blank to use local Dev Preview mode (prints OTP in terminal/UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=

# 3. Avalanche Fuji Testnet (Chain ID 43113) Smart Contract Bridge
# Leave blank to run in local SQLite simulation mode without broadcasting on-chain
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_CONTRACT_ADDRESS=0xf2dBC98658CDEa971DFB8CD1D2CF160FcfC95552
FUJI_SIGNER_PRIVATE_KEY=

# 4. Optional: Gemini API Key for Cò Mạ Assistant
GEMINI_API_KEY=

# 5. Optional: Custom SQLite Database Path
# AGRIDATA_DB_PATH=data/agridata.db

# 6. Central accounts (enable only after the Site D1 deployment is verified)
# AUTH_API_URL=https://mach-dong-rice-data.artfulmica6.chatgpt.site
